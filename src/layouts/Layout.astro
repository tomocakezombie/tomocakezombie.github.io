---
import Util from '@/config/Util.mjs';
import { args, rootPath, assets, img } from '@/config/view.mjs';
import Header from './Header.astro';
import Footer from './Footer.astro';
import PageFooter from '@/components/PageFooter.astro';
import ScoreHud from '@/components/ScoreHud.astro';
---

<!doctype html>
<html lang={args.lang} data-font="normal" data-key={args.page.key} data-route={args.page.route} data-app-route={args.page.appRoute}>
  <head>
    <meta charset="UTF-8" />
    <title>{args.title}</title>
    <meta name="description" content={args.description} />

    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1" />
    <meta name="format-detection" content="telephone=no, email=no, address=no" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:locale" content={args.locale} />
    <meta property="og:type" content={args.og_type} />
    <meta property="og:site_name" content={args.siteName} />
    <meta property="og:title" content={args.title} />
    <meta property="og:description" content={args.description} />
    <meta property="og:image" content={args.og_image} />
    <meta property="og:url" content={args.url} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={args.title} />
    <meta name="twitter:description" content={args.description} />
    <meta name="twitter:site" content={args.twitterIdWithAtMark} />

    <link rel="icon" type="image/svg+xml" href={rootPath('favicon.svg', true)} />
    <link rel="icon" type="image/vnd.microsoft.icon" href={rootPath('favicon.ico', true)} />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/all.min.css" integrity="sha512-1ycoCasTpxU6aMJ5w1vmkX0+zWXl7hhNSYEVWVZWQvt3UYXD+kzFU/yKJbXsm+LoMvHiJgzcJ1wkf6iJxvtuw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    {!args.prevent.css.reset && <link rel="stylesheet" href={assets('css/global/reset.css', true)} />}
    {!args.prevent.css.style && <link rel="stylesheet" href={assets('css/global/style.css', true)} />}
    <script src={assets('js/global/base.js', true)}></script>
    <script src={assets('js/global/score.js', true)}></script>
    <script is:inline>
      // 初期値は <html data-font="normal">（ふつうのフォント）。ドットフォントを選んで保存した人だけ切り替える
      try {
        if (localStorage.getItem('font') === 'pixel') document.documentElement.dataset.font = 'pixel';
      } catch {}
    </script>
    <script is:inline>
      if (location.hostname !== 'localhost' && location.hostname !== '127.0.0.1') {
        const gtagScript = document.createElement('script');
        gtagScript.async = true;
        gtagScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-7WBLJGVRWN';
        document.head.appendChild(gtagScript);
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        gtag('js', new Date());
        gtag('config', 'G-7WBLJGVRWN');
      }
    </script>
    {args.assetList.css.map((css) => <link rel="stylesheet" href={assets('css/' + Util.ltrim(css), true)} />)}
    {args.assetList.js.map((js) => <script src={assets('js/' + Util.ltrim(js), true)} />)}
  </head>
  <body>
    <div id="page-container">
      {
        !args.prevent.header && (
          <header id="page-header">
            <Header />
          </header>
        )
      }
      <main id="page-main">
        <ScoreHud />
        <slot />
        {args.page.key !== 'top' && <PageFooter />}
      </main>
      {
        !args.prevent.footer && (
          <footer id="page-footer">
            <Footer />
          </footer>
        )
      }
    </div>
  </body>
</html>
