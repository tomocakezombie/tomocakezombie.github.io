---
import { args, pages, img } from '/src/config/view';

const navItems = [
  { key: 'top', label: 'トップ' },
  { key: 'about', label: '自己紹介' },
  { key: 'projects', label: '作品' },
  { key: 'achievements', label: '実績' },
  { key: 'links', label: '外部リンク' },
];
---

<div class="header-inner">
  <h1 class="siteName"><a href={pages.top.route}><img src={img('global/logo.png')} alt={args.siteName} /></a></h1>
  <button class="nav-toggle" aria-label="メニューを開く" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
  <nav class="header-nav">
    <ul class="nav-list">
      {
        navItems.map((item) => (
          <li>
            <a href={pages[item.key].route} aria-current={args.page.key === item.key ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<script>
  const toggleBtn = document.querySelector('.nav-toggle');
  const header = document.querySelector('#page-header');

  toggleBtn?.addEventListener('click', () => {
    header?.classList.toggle('is-open');
    const isOpen = header?.classList.contains('is-open') ?? false;
    toggleBtn.setAttribute('aria-expanded', isOpen.toString());
  });

  // メニューリンククリック時にメニューを閉じる
  document.querySelectorAll('.header-nav a').forEach(link => {
    link.addEventListener('click', () => {
      header?.classList.remove('is-open');
      toggleBtn?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
