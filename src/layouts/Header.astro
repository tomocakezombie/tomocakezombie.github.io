---
import { args, pages, img } from '/src/config/view';

const navItems = [
  { key: 'top', label: 'トップ' },
  { key: 'about', label: '自己紹介' },
  // { key: 'works', label: '作品集' },
  { key: 'links', label: '外部リンク' },
];
---

<div class="header-inner">
  <h1 class="siteName"><a href={pages.top.route}><img src={img('global/logo2.svg')} alt={args.siteName} /></a></h1>
  <button class="nav-toggle" aria-label="メニューを開く" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
  <nav class="header-nav">
    <ul class="nav-list">
      {
        navItems.map((item) => (
          <li>
            <a href={pages[item.key].route} aria-current={args.page.key === item.key ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>
