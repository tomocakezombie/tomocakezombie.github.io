---
// src/components/Breadcrumb.astro
const { items } = Astro.props;
// items = [{ label: 'Top', route: '/' }, { label: 'About', route: '/about/' }]
---
<nav class="breadcrumb">
  <ol class="content-main">
    {items.map((item, i) => (
      <li>
        {i < items.length - 1
          ? <a href={item.route}>{item.label} </a>
          : <span>{item.label}</span>
        }
      </li>
    ))}
  </ol>
</nav>

<style>
  ol {
    display: flex;
    list-style: none;
    padding: 0;
    margin-top: 5rem;
    margin-bottom: 5rem;
    gap: 0.5rem;
  }
  li:not(:last-child)::after {
    content: '>';
    margin-left: 0.7rem;
  }
</style>
