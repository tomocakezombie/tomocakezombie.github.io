---
// src/components/Breadcrumb.astro
const { items } = Astro.props;
// items = [{ label: 'Top', route: '/' }, { label: 'About', route: '/about/' }]
---
<nav class="breadcrumb">
  <ol class="content-main">
    {items.map((item, i) => (
      <li>
        {i < items.length - 1
          ? <a href={item.route}>{item.label} </a>
          : <span>{item.label}</span>
        }
      </li>
    ))}
  </ol>
</nav>

<style>
  /* 1 dot = 2px */
  ol {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin-top: 24px;
    margin-bottom: 32px;
    gap: 8px;
  }
  li:not(:last-child)::after {
    content: '>';
    margin-left: 8px;
  }
</style>
