---
const { href, label, date, title } = Astro.props;

const labelColors: Record<string, string> = {
  '開発': '#1a6b3a',
  '学内': '#123068',
  '所属': '#8a3fb8',
  'SNS': '#1d9bf0',
};
const labelColor = label ? (labelColors[label] ?? '#555') : '';
---
<a href={href} target="_blank" rel="noopener noreferrer" class="link-item">
  <div class="link-item__meta">
    {label && <span class="link-item__label" style={`background: ${labelColor}`}>{label}</span>}
    {date && <span class="link-item__date">{date}</span>}
  </div>
  <p class="link-item__title">{title}</p>
</a>

<style>
  /* Pixel-art list item: 1 dot = 2px */
  .link-item {
    display: block;
    position: relative;
    padding: 8px 12px 8px 28px;
    color: #1b2a4a;
    text-decoration: none;
    background-image: linear-gradient(to right, rgb(27 42 74 / 0.3) 50%, transparent 50%);
    background-size: 4px 2px;
    background-repeat: repeat-x;
    background-position: left bottom;

    &::before {
      content: '▶';
      position: absolute;
      top: 10px;
      left: 8px;
      font-size: 1.2rem;
      visibility: hidden;
    }

    &:hover,
    &:focus-visible {
      color: #1b2a4a;
      background-color: #ffd84a;
    }

    &:hover::before,
    &:focus-visible::before {
      visibility: visible;
    }
  }

  .link-item__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
  }

  .link-item__label {
    display: inline-block;
    min-width: 4em;
    padding: 0 8px;
    font-size: 1.2rem;
    line-height: 2;
    text-align: center;
    color: #fff;
  }

  .link-item__date {
    font-size: 1.2rem;
    color: #5a6b80;
  }

  .link-item__title {
    font-size: 1.6rem;
    font-weight: bold;
  }
</style>
