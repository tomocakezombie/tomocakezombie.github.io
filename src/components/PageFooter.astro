---
import { img } from '@/config/view.mjs';
---

<div class="to-top-area content-main">
  <p class="to-top-area__text">
    <span class="wbr">ページの上にもどるときは，</span><span class="wbr">ここを押してね</span>
    <span class="to-top-area__arrow" aria-hidden="true">▶</span>
  </p>
  <a class="to-top" href="#page-container" aria-label="ページの先頭へ戻る">
    <img class="to-top__default" src={img('global/to-top.png')} alt="" width="50" height="34" />
    <img class="to-top__hover" src={img('global/to-top-hover.png')} alt="" width="50" height="34" aria-hidden="true" />
  </a>
</div>
