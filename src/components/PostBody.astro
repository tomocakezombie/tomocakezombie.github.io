---
// ブログ記事の本文を描画する。blocks の各要素は次のいずれか
//   '文字列'                                  段落
//   { type: 'heading', text }                 見出し
//   { type: 'list', items: ['…', '…'] }       箇条書き
//   { type: 'image', src, alt, caption }      画像（src は /assets/img/blog/… など）
//   { type: 'link', label, url }              外部リンクのボタン
const { blocks = [] } = Astro.props;
---

{
  blocks.map((block) => {
    if (typeof block === 'string') return <p>{block}</p>;
    switch (block.type) {
      case 'heading':
        return <h3 class="blog-post__heading">{block.text}</h3>;
      case 'list':
        return (
          <ul class="blog-post__list">
            {block.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        );
      case 'image':
        return (
          <figure class="blog-post__figure">
            <img src={block.src} alt={block.alt ?? ''} loading="lazy" />
            {block.caption && <figcaption>{block.caption}</figcaption>}
          </figure>
        );
      case 'link':
        return (
          <p>
            <a class="pixel-btn" href={block.url} target="_blank" rel="noopener noreferrer">
              {block.label}
            </a>
          </p>
        );
      default:
        return null;
    }
  })
}
