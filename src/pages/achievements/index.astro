---
import { app, args, pages, assets, img } from '@/config/view.mjs';
import { Layout } from '@/layouts';
import { certifications, languages, programs, ctfs } from './_achievements.mjs';
import Breadcrumb from '@/components/Breadcrumb.astro';
app.init(Astro);
app.setPageConfig({
  title: '実績',
  description: 'tomocakezombie の実績ページです。情報系資格・語学・研修プログラム・CTF 実績をまとめています。',
});

const statusLabel = { done: '取得', plan: '予定' };
---

<Layout>
  <Breadcrumb items={[
      { label: 'トップ', route: pages.top.route },
      { label: '実績', route: pages.achievements.route },
    ]} />
  <div class="content-main">
    <h2>実績</h2>
    <p class="lead">これまでの資格取得・語学・研修プログラム・CTF 参加などの実績をまとめています．</p>

    <section class="section">
      <h3>情報系資格</h3>
      <div class="pixel-window">
        <dl class="works-status">
          {
            certifications.map((item) => (
              <div>
                <dt>{item.year}</dt>
                <dd>
                  {item.name} <span class:list={['pixel-tag', `is-${item.status}`]}>{statusLabel[item.status]}</span>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="section">
      <h3>語学</h3>
      <div class="pixel-window">
        <dl class="works-status">
          {
            languages.map((item) => (
              <div>
                <dt>{item.year}</dt>
                <dd>{item.name} {item.score}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="section">
      <h3>研修・プログラム</h3>
      <div class="pixel-window">
        <dl class="works-status">
          {
            programs.map((item) => (
              <div>
                <dt>{item.year}</dt>
                <dd>
                  {item.name} <span class="pixel-tag">{item.label}</span>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="section">
      <h3>CTF 実績</h3>
      <ul class="works-list">
        {
          ctfs.map((item) => (
            <li class="works-card pixel-window">
              <div class="works-card__meta">
                <span class="pixel-tag">CTF</span>
                <span class="works-card__date">{item.year}</span>
              </div>
              <p class="works-card__title">{item.name}</p>
              <dl class="works-card__detail">
                <div>
                  <dt>順位</dt>
                  <dd>{item.rank}</dd>
                </div>
                {item.scale && (
                  <div>
                    <dt>規模</dt>
                    <dd>{item.scale}</dd>
                  </div>
                )}
                <div>
                  <dt>チーム</dt>
                  <dd>{item.team}</dd>
                </div>
                {item.details.length > 0 && (
                  <div>
                    <dt>コメント</dt>
                    <dd>
                      <ul class="works-card__notes">
                        {item.details.map((line) => (
                          <li>{line}</li>
                        ))}
                      </ul>
                    </dd>
                  </div>
                )}
              </dl>
              {item.links.length > 0 && (
                <ul class="works-card__links">
                  {item.links.map((link) => (
                    <li>
                      <a class="pixel-btn" href={link.url} target="_blank" rel="noopener noreferrer">
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Layout>
