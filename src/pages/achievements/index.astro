---
import { app, args, pages, assets, img } from '@/config/view.mjs';
import { Layout } from '@/layouts';
import Breadcrumb from '@/components/Breadcrumb.astro';
app.init(Astro);
app.setPageConfig({
  title: '実績',
  description: 'tomocakezombie の実績ページです。情報系資格・サークル経歴・CTF 実績をまとめています。',
});

// TODO: 以下はダミーデータ。実際の内容に差し替える
// status: 'done'（取得済み） / 'plan'（受験予定）
const certifications = [
  { name: '基本情報技術者試験（FE）', year: '2024年度', status: 'done', note: '一回受験で合格' },
  { name: '応用情報技術者試験（AP）', year: '2024年度', status: 'done', note: '一回受験で合格' },
  { name: '情報安全確保支援士試験（SC）', year: '2025年度', status: 'done', note: '二回受験で合格' },
];

const background = [
  { name: '山梨大学入学', role: '学部生', period: '2023 - 現在'},
  { name: 'kki-assist', role: '代表', period: '2025 後期 - 2026 前期' },
  { name: 'kki-assist', role: '副代表', period: '2024 前期 - 2025 前期' },
  { name: 'kki-assist', role: '部員', period: '2023 - 現在' },
  { name: 'セキュリティミニキャンプ in山梨', role: '受講者', period: '2025' },
  { name: '井上研究室に参加', role: '研究室生', period: '2025 - 現在' },
  { name: 'セキュリティキャンプ全国 Cクラス', role: '受講者', period: '2026' },
];

// links は省略可。{ label: 'リンクの表示名', url: 'https://...' } を並べる
// scale は省略可。参加規模（例: '15チーム/30名'）
// details は省略可。参加形式など、補足を 1 行ずつ文字列で書く
const ctfs = [
  {
    name: '	サイバーセキュリティCTFコンテンスト2024',
    year: '2024',
    rank: '8位くらい / 2人チーム',
    team: 'CTF Lovers',
    scale: '15チーム/30名',
    details: ['初めて対面で参加した CTF です．'],
    links: [{ label: '参考Webページ(外部)', url: 'https://www.ysa.or.jp/?p=1980' }],
  },
  {
    name: '山梨県警察主催 学生サイバーセキュリティCTFコンテスト',
    year: '2025',
    rank: '1位 / 2人チーム',
    team: 'CTF狂い',
    scale: '16チーム/30名',
    details: ['1位を獲得しました．', '嬉しかったです．'],
    links: [{ label: '参考Webページ(外部)', url: 'https://www.ysa.or.jp/?p=2100' }],
  },
  {
    name: '関東管区内警察合同サイバーボランティア・学生',
    year: '2026',
    rank: '2位 / 3人チーム',
    team: '空っぽコード',
    scale : '59チーム/150人',
    details: ['2位を獲得しました．', '優勝は逃しましたが，良い経験を積めました．'],
    links: [{ label: '参考Webページ(外部)', url: 'https://www.keio.ac.jp/ja/sfc-pem/news/20260319/' }],
  },
];

const statusLabel = { done: '取得', plan: '予定' };
---

<Layout>
  <Breadcrumb items={[
      { label: 'トップ', route: pages.top.route },
      { label: '実績', route: pages.achievements.route },
    ]} />
  <div class="content-main">
    <h2>実績</h2>
    <p class="lead">これまでの資格取得・サークル活動・CTF 参加などの実績をまとめています．</p>

    <section class="section">
      <h3>情報系資格</h3>
      <div class="pixel-window">
        <dl class="works-status">
          {
            certifications.map((item) => (
              <div>
                <dt>{item.year}</dt>
                <dd>
                  {item.name} <span class:list={['pixel-tag', `is-${item.status}`]}>{statusLabel[item.status]}</span>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="section">
      <h3>経歴</h3>
      <div class="pixel-window">
        <dl class="works-status">
          {
            background.map((item) => (
              <div>
                <dt>{item.period}</dt>
                <dd>
                  {item.name} <span class="pixel-tag">{item.role}</span>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="section">
      <h3>CTF 実績</h3>
      <ul class="works-list">
        {
          ctfs.map((item) => (
            <li class="works-card pixel-window">
              <div class="works-card__meta">
                <span class="pixel-tag">CTF</span>
                <span class="works-card__date">{item.year}</span>
              </div>
              <p class="works-card__title">{item.name}</p>
              <dl class="works-card__detail">
                <div>
                  <dt>順位</dt>
                  <dd>{item.rank}</dd>
                </div>
                {item.scale && (
                  <div>
                    <dt>規模</dt>
                    <dd>{item.scale}</dd>
                  </div>
                )}
                <div>
                  <dt>チーム</dt>
                  <dd>{item.team}</dd>
                </div>
                {item.details.length > 0 && (
                  <div>
                    <dt>コメント</dt>
                    <dd>
                      <ul class="works-card__notes">
                        {item.details.map((line) => (
                          <li>{line}</li>
                        ))}
                      </ul>
                    </dd>
                  </div>
                )}
              </dl>
              {item.links.length > 0 && (
                <ul class="works-card__links">
                  {item.links.map((link) => (
                    <li>
                      <a class="pixel-btn" href={link.url} target="_blank" rel="noopener noreferrer">
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Layout>
