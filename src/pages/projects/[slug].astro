---
import { app, args, pages, assets, img } from '@/config/view.mjs';
import { Layout } from '@/layouts';
import Breadcrumb from '@/components/Breadcrumb.astro';
import PostBlocks from '@/components/PostBlocks.astro';
import { parseMarkdown } from '@/components/markdown.mjs';
import { projects } from './_projects.mjs';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;

// 説明は Markdown で書く（段落・入れ子の箇条書き・**太字** など。書き方は drafts/README.md の「本文」）
const descriptionBlocks = parseMarkdown(project.description ?? '', (message) => {
  console.warn(`警告 projects/${project.slug}: ${message}`);
});
// meta description には、最初の段落を書式記号を外した文字列で使う
const firstParagraph = descriptionBlocks.find((block) => typeof block === 'string');
const summary = firstParagraph
  ?.replace(/\*\*([^*]+)\*\*/g, '$1')
  .replace(/`([^`]+)`/g, '$1')
  .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1');

app.init(Astro);
app.setPageConfig({
  title: project.title,
  description: summary ?? `${project.title} - tomocakezombie の作品です。`,
});

// 動的ルートは pages に登録されないため、作品として扱い projects.css を読み込む
args.page.key = 'projects';
if (!args.assetList.css.includes('pages/projects.css')) args.assetList.css.push('pages/projects.css');
if (!args.assetList.js.includes('pages/projects.js')) args.assetList.js.push('pages/projects.js');

const images = project.images ?? [];
---

<Layout>
  <Breadcrumb items={[
      { label: 'トップ', route: pages.top.route },
      { label: '作品', route: pages.projects.route },
      { label: project.title, route: '' },
    ]} />
  <div class="content-main">
    <article class="project-detail">
      <h2 class="project-detail__title">{project.title}</h2>

      {project.videoFile && (
        <div class="project-detail__media pixel-window">
          <video
            class="project-detail__video"
            src={`/assets/video/${project.videoFile}`}
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label={`${project.title} のデモ動画`}
          />
        </div>
      )}

      {images.length > 0 && (
        <section class="project-detail__gallery pixel-window" aria-label="スクリーンショット" aria-roledescription="カルーセル" data-carousel>
          <h3 class="project-detail__heading">スクリーンショット</h3>
          <ul class="project-detail__shots" data-carousel-track>
            {images.map((image, index) => (
              <li class="project-detail__slide" aria-roledescription="スライド" aria-label={`${index + 1} / ${images.length}`}>
                <figure class="project-detail__shot">
                  <button
                    type="button"
                    class="project-detail__shot-button"
                    data-lightbox-src={`/assets/img/projects/${image.file}`}
                    data-lightbox-caption={image.caption ?? ''}
                    aria-label={`${image.alt} を拡大表示`}
                  >
                    <img
                      class="project-detail__shot-img"
                      src={`/assets/img/projects/${image.file}`}
                      alt={image.alt}
                      decoding="async"
                    />
                  </button>
                  {image.caption && <figcaption class="project-detail__caption">{image.caption}</figcaption>}
                </figure>
              </li>
            ))}
          </ul>
          {images.length > 1 && (
            <div class="project-detail__carousel-nav">
              <button type="button" class="project-detail__carousel-arrow pixel-btn" data-carousel-prev aria-label="前の画像">◀</button>
              <ul class="project-detail__carousel-dots">
                {images.map((_, index) => (
                  <li>
                    <button
                      type="button"
                      class="project-detail__carousel-dot"
                      data-carousel-dot={index}
                      aria-label={`${index + 1} 枚目を表示`}
                      aria-current={index === 0 ? 'true' : undefined}
                    />
                  </li>
                ))}
              </ul>
              <button type="button" class="project-detail__carousel-arrow pixel-btn" data-carousel-next aria-label="次の画像">▶</button>
            </div>
          )}
        </section>
      )}

      <div class="project-detail__body pixel-window">
        <section class="project-detail__section">
          <h3 class="project-detail__heading">説明</h3>
          <div class="project-detail__text">
            {descriptionBlocks.length > 0 ? <PostBlocks blocks={descriptionBlocks} /> : <p>準備中...</p>}
          </div>
          <div class="project-detail__divider"></div>
        </section>

        {project.tech?.length > 0 && (
          <section class="project-detail__section">
            <h3 class="project-detail__heading">使用技術</h3>
            <ul class="project-detail__tech">
              {project.tech.map((tech) => (
                <li class="pixel-tag">{tech}</li>
              ))}
            </ul>
          </section>
          <div class="project-detail__divider"></div>
        )}

        {project.github && (
          <section class="project-detail__section">
            <h3 class="project-detail__heading">ソースコード</h3>
            <p class="project-detail__links project-detail__links--no-divider">
              <a class="pixel-btn" href={project.github} target="_blank" rel="noopener noreferrer">
                <img src="/assets/img/github-icon.png" alt="GitHub" class="github-icon" /> GitHub
              </a>
            </p>
          </section>
        )}

        {project.demo && (
          <p class="project-detail__links">
            <a class="pixel-btn" href={project.demo} target="_blank" rel="noopener noreferrer">
              デモをみる
            </a>
          </p>
        )}
      </div>
    </article>
  </div>

  {images.length > 0 && (
    <dialog class="project-lightbox" aria-label="拡大表示">
      <figure class="project-lightbox__figure">
        <img class="project-lightbox__img" src="" alt="" />
        <figcaption class="project-lightbox__caption"></figcaption>
      </figure>
      <button type="button" class="project-lightbox__close pixel-btn" aria-label="閉じる">×</button>
    </dialog>
  )}
</Layout>
