---
import { app, args, pages, assets, img } from '/src/config/view';
import { Layout } from '/src/layouts';
import Breadcrumb from '/src/components/Breadcrumb.astro';
import { projects } from './_projects.mjs';
app.init(Astro);
app.setPageConfig({
  title: '作品',
  description: 'tomocakezombie の作品ページです。これまでに制作した作品を紹介します。',
});
---

<Layout>
  <Breadcrumb items={[
      { label: 'トップ', route: pages.top.route },
      { label: '作品', route: pages.projects.route },
    ]} />
  <div class="content-main">
    <h2>作品</h2>
    <p class="lead">これまでに制作した作品を紹介します．</p>

    <section class="section">
      <h3>作品一覧</h3>
      {
        projects.length > 0 ? (
          <ul class="projects-list">
            {projects.map((project) => (
              <li>
                <a class="projects-card pixel-window" href={`${pages.projects.route}${project.slug}/`}>
                  <span class="projects-card__title">{project.title}</span>
                  {project.videoFile && (
                    <span class="projects-card__media">
                      <video
                        class="projects-card__video"
                        src={`/assets/video/${project.videoFile}`}
                        autoplay
                        muted
                        loop
                        playsinline
                        preload="metadata"
                        aria-label={`${project.title} のデモ動画`}
                      />
                    </span>
                  )}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="projects-empty pixel-window">準備中...</p>
        )
      }
    </section>
  </div>
</Layout>
