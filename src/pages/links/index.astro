---
import { app, args, pages, assets, img } from '/src/config/view';
import { Layout } from '/src/layouts';
import Breadcrumb from '/src/components/Breadcrumb.astro';
import LinkItem from '/src/components/LinkItem.astro';
app.init(Astro);
app.setPageConfig({
  title: '外部リンク',
  description: 'tomocakezombie の外部リンク集です。GitHub や所属サークル、学内サイトへのリンクをまとめています。',
});
---

<Layout>
  <Breadcrumb items={[
      { label: 'トップ', route: pages.top.route },
      { label: '外部リンク', route: pages.links.route },
    ]} />
  <div class="content-main">
    <h2>外部リンク</h2>
    <p class="lead">GitHub や所属サークル，学内サイトなど，わたしに関係するリンクをまとめています．</p>

    <section class="link-card pixel-window">
      <h3 class="link-card__title">開発・外部サービス</h3>
      <ul class="link-card__list">
        <li>
          <LinkItem
            href="https://github.com/tomocakezombie"
            label="開発"
            date="2026/06/10"
            title="GitHub（ソースコード・リポジトリ）"
          />
        </li>
        <!-- <li>
          <LinkItem
            href="https://lww.kki.yamanashi.ac.jp/~t23cs014/"
            label="学内"
            title="学内で作成した個人サイト（学内関係者専用）"
          />
        </li> -->
      </ul>
    </section>

    <section class="link-card pixel-window">
      <h3 class="link-card__title">大学・サークル</h3>
      <ul class="link-card__list">
        <li>
          <LinkItem
            href="https://www.kki.yamanashi.ac.jp/~assist/assist_activity/"
            label="所属"
            date="2026/06/10"
            title="学内計算機システム・保守運用サークル"
          />
        </li>
        <li>
          <LinkItem
            href="https://lww.kki.yamanashi.ac.jp/~t23cs014/"
            label="開発"
            title="学内で作成した個人サイト（学内関係者専用）"
          />
        </li>
        <li>
          <LinkItem
            href="https://lww.kki.yamanashi.ac.jp/"
            label="学内"
            title="学内計算機システムトップページ"
          />
        </li>
        <li>
          <LinkItem
            href="https://www.kki.yamanashi.ac.jp/"
            label="学内"
            title="学内計算機システムについての情報サイト"
          />
        </li>
      </ul>
    </section>

  </div>
</Layout>
