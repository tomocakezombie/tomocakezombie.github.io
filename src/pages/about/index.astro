---
import { app, args, pages, assets, img } from '/src/config/view';
import { Layout } from '/src/layouts';
import Breadcrumb from '/src/components/Breadcrumb.astro';
app.init(Astro);
app.setPageConfig({
  title: '自己紹介',
  description: 'tomocakezombie の自己紹介ページです。所属や普段の活動について紹介しています。',
});
---

<Layout>
  <Breadcrumb items={[
      { label: 'トップ', route: pages.top.route },
      { label: '自己紹介', route: pages.about.route },
    ]} />
  <div class="content-main">
    <h2>自己紹介</h2>
    <p class="lead">はじめまして．このページでは，わたしのプロフィールを紹介します．</p>

    <section class="section">
      <div class="pixel-window profile">
        <div class="profile__icon">
          <img src={img('about/profile.png')} alt="プロフィール画像" width="160" height="160" />
        </div>
        <div class="profile__body">
          <p class="profile__name">{args.siteName}</p>
          <dl class="profile__status">
            <div>
              <dt>所属</dt>
              <dd>山梨大学 工学部 コンピュータ理工学科</dd>
            </div>
            <div>
              <dt>サークル</dt>
              <dd>KKI-Assist（学内計算機システム・保守運用サークル）</dd>
            </div>
            <div>
              <dt>アルバイト</dt>
              <dd>ソフトウェア開発アルバイト（チーム開発）</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section class="section">
      <h3>ひとこと</h3>
      <div class="pixel-window">
        <p>こんにちは．</p>
        <p>山梨大学工学部コンピュータ理工学科に所属している学生です．</p>
        <p>普段は住み込みで開発バイトをしながら学校に通っています．</p>
        <p>あと KKI-Assist という団体に所属しています．</p>
        <p>散歩をしたり，食べたりする時間が好きです．</p>
        <p>よろしくお願いします．</p>
      </div>
    </section>

    <section class="section">
      <h3>アルバイト</h3>
      <div class="pixel-window">
        <p>大学２年生からソフトウェア開発のアルバイトをしています．</p>
        <p>主に実装業務に携わっていて，コード自体の難易度の高さに苦しみながらも成長していっています．</p>
        <p>業務ではバイト間で協力し，チームで目標を達成しています．</p>
        <p>日頃，大学での学習とアルバイトの両立に努力しています．</p>
      </div>
    </section>

    <section class="section">
      <h3>KKI-Assist</h3>
      <div class="pixel-window">
        <p>KKI-Assist は，学内での計算機システムや保守運用に関する活動を行う団体です．</p>
        <p>大学3年生くらいから副代表を務めて，４年生で代表になりました．</p>
        <p>学生ではありますが，保守活動を通して，実務経験を積んでいます(自称)．</p>
      </div>
    </section>

    <section class="section">
      <h3>主に携わっている技術</h3>
      <div class="pixel-window">
        <p>C++</p>
        <p>Python</p>
        <p>JavaScript</p>
        <p>TypeScript</p>
        <p>HTML / CSS</p>
      </div>
    </section>

    <section class="section">
      <h3>リンク</h3>
      <p class="about-links">
        <a class="pixel-btn" href="https://github.com/tomocakezombie" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a class="pixel-btn" href={pages.links.route}>外部リンク一覧へ</a>
      </p>
    </section>
    
  </div>
</Layout>
