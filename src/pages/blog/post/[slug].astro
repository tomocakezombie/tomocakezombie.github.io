---
import { app, args, pages, assets, img } from '@/config/view.mjs';
import { Layout } from '@/layouts';
import Breadcrumb from '@/components/Breadcrumb.astro';
import PostBody from '@/components/PostBody.astro';
import { posts } from '../_posts.mjs';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;

app.init(Astro);
app.setPageConfig({
  title: post.title,
  description: post.description ?? `${post.title} - tomocakezombie のブログ記事です。`,
});

// 動的ルートは pages に登録されないため、ブログとして扱い blog.css を読み込む
args.page.key = 'blog';
if (!args.assetList.css.includes('pages/blog.css')) args.assetList.css.push('pages/blog.css');
---

<Layout>
  <Breadcrumb items={[
      { label: 'トップ', route: pages.top.route },
      { label: 'ブログ', route: pages.blog.route },
      { label: post.title, route: '' },
    ]} />
  <div class="content-main">
    <article class="blog-post">
      <header class="blog-post__header">
        <p class="blog-post__meta">
          <time class="blog-post__date" datetime={post.date}>{post.date}</time>
          {post.tags?.map((tag) => (
            <a class="pixel-tag blog-post__tag" href={`${pages.blog.route}?tag=${encodeURIComponent(tag)}`}>
              {tag}
            </a>
          ))}
        </p>
        <h2 class="blog-post__title">{post.title}</h2>
      </header>

      {post.site && (
        <section class="blog-site pixel-window">
          <h3 class="blog-post__heading">サイト情報</h3>
          <dl class="blog-site__list">
            <div>
              <dt>サイト</dt>
              <dd>
                {post.site.url ? (
                  <a href={post.site.url} target="_blank" rel="noopener noreferrer">
                    {post.site.name}
                  </a>
                ) : (
                  post.site.name
                )}
              </dd>
            </div>
            {post.site.role && (
              <div>
                <dt>役割</dt>
                <dd>{post.site.role}</dd>
              </div>
            )}
            {post.site.period && (
              <div>
                <dt>期間</dt>
                <dd>{post.site.period}</dd>
              </div>
            )}
            {post.site.tech?.length > 0 && (
              <div>
                <dt>技術</dt>
                <dd class="blog-site__tech">
                  {post.site.tech.map((tech) => (
                    <span class="pixel-tag">{tech}</span>
                  ))}
                </dd>
              </div>
            )}
          </dl>
        </section>
      )}

      <div class="blog-post__body pixel-window">
        {post.body?.length > 0 ? <PostBody blocks={post.body} /> : <p>じゅんびちゅう...</p>}
      </div>
    </article>
  </div>
</Layout>
