---
import { app, args, pages, assets, img } from '@/config/view.mjs';
import { Layout } from '@/layouts';
import { certifications, programs, ctfs } from './achievements/_achievements.mjs';
import { projects } from './projects/_projects.mjs';
import githubStats from '@/data/github-stats.json';
app.init(Astro);
app.setPageConfig();

// ステータス画面の項目
const job = 'がくせい（B4）';
const status = [
  { label: 'しょぞく', value: '山梨大学 工学部 コンピュータ理工学科' },
  { label: 'とくい', value: 'セキュリティ・計算機運用' },
];

// しょうごう：実績データのうち highlight: true のものだけを出す
// value は大きく表示する一言（順位・合格など）
const titles = [
  ...programs.filter((item) => item.highlight).map((item) => ({ year: item.year, value: item.label, name: item.name })),
  ...certifications.filter((item) => item.highlight).map((item) => ({ year: item.year, value: '合格', name: item.name })),
  ...ctfs.filter((item) => item.highlight).map((item) => ({ year: item.year, value: item.rank.split(' / ')[0], name: item.name })),
];

// コマンドメニュー。選ぶと message がメッセージウィンドウに 1 文字ずつ出る
// preview を書いたものは、選んでいる間だけ同じ名前の data-preview の中身も表示する
const commands = [
  { label: 'じこしょうかい', route: pages.about.route, message: 'tomocakezombie の プロフィールや しょぞく，ふだんの かつどうを みる。' },
  { label: 'さくひん', route: pages.projects.route, message: 'これまでに つくった アプリや ゲームを みる。', preview: 'projects' },
  { label: 'じっせき', route: pages.achievements.route, message: 'しかく・ごがく・けんしゅう・CTF・ハッカソンの じっせきを みる。' },
  { label: 'ブログ', route: pages.blog.route, message: 'ぎじゅつメモや かつどうきろく。' },
  { label: 'リンク', route: pages.links.route, message: 'GitHub や がくないサイトへの リンクを みる。' },
  { label: 'きろく', route: pages.record.route, message: 'このサイトで あそんで あつめた きろくを みる。\nぜんぶ あつめられるかな？' },
  { label: 'せってい', route: pages.settings.route, message: 'フォントを きりかえたり スコアを リセットしたり できる。' },
];
// message は選んだときの説明、callMessage は実行したとき、leaveMessage は呼んだハムスターが全員画面の外へ出たときに出る
const secretCommand = {
  label: 'ハムスターをよぶ',
  message: 'ハムスターを よんで、がめんに あつめる。\nたくさん くるので ちゅうい。',
  callMessage: 'ハムスターたちが あつまってきた！',
  leaveMessage: 'ハムスターたちは さっそうと さっていった…',
};
const featuredProjects = projects.filter((project) => project.featured);

// GitHub の実績（build/fetch-github-stats.mjs がビルド時に取得した JSON）
// 一度も取得できていない（fetchedAt が null）ときは出さない
const formatNumber = (value: number) => value.toLocaleString('ja-JP');
const fetchedDate = githubStats.fetchedAt ? new Date(githubStats.fetchedAt).toLocaleDateString('ja-JP', { timeZone: 'Asia/Tokyo' }) : '';

// 草：週ごとに縦 7 マス（日〜土）。先頭の週が日曜始まりでないときは空きマスで詰める
type GrassDay = { date: string; count: number; level: number };
const grassWeeks: GrassDay[][] = githubStats.weeks ?? [];
const grassOffset = grassWeeks[0]?.[0] ? new Date(`${grassWeeks[0][0].date}T00:00:00Z`).getUTCDay() : 0;
const grassDays = grassWeeks.flat();

// 草のデータから計算するゲージ
// れんぞく：いちばん新しい日から さかのぼって つづいている日数（今日がまだ 0 件なら きのうまで）。さいちょう は 1 年の中の最長
const activeDays = grassDays.filter((day) => day.count > 0).length;
const streaks = (() => {
  let longest = 0;
  let run = 0;
  for (const day of grassDays) {
    run = day.count > 0 ? run + 1 : 0;
    longest = Math.max(longest, run);
  }
  let current = 0;
  for (let i = grassDays.length - 1; i >= 0; i -= 1) {
    if (grassDays[i].count > 0) current += 1;
    else if (i !== grassDays.length - 1) break;
  }
  return { current, longest };
})();
const github = githubStats.fetchedAt
  ? {
      total: formatNumber(githubStats.totalContributions),
      gauges:
        grassDays.length > 0
          ? [
              { label: 'かつどうび', now: activeDays, max: grassDays.length },
              { label: 'れんぞく', now: streaks.current, max: Math.max(streaks.longest, 1), maxLabel: 'さいちょう' },
            ]
          : [],
    }
  : null;

// レベルは しょうごう の数（実績が増えると上がる）
const level = titles.length;

const contacts = [
  { label: 'メール', text: 't23cs014@yamanashi.ac.jp', href: 'mailto:t23cs014@yamanashi.ac.jp', external: false },
  { label: 'GitHub', text: 'tomocakezombie', href: 'https://github.com/tomocakezombie', external: true },
  { label: 'X', text: '@kan1175423', href: 'https://x.com/kan1175423', external: true },
];
---

<Layout>
  <div class="hamster-container" id="hamsterContainer"></div>
  <button type="button" class="walker" data-score="0" aria-label="あるく ぼうにんげんを つかまえる" hidden>
    <img src="/assets/img/walking-stickman.svg" alt="" />
  </button>
  <div class="content-main">
    <section class="hero title-screen" id="title">
      <p class="hero__sub">PORTFOLIO</p>
      <h2 class="hero__title">{args.siteName}</h2>
      <p class="hero__text">
        <span class="wbr">山梨大学 工学部</span> <span class="wbr">コンピュータ理工学科の学生です．</span><br />
        <span class="wbr">サイバーセキュリティと計算機の保守運用をメインに活動しています．</span><br />
        <span class="wbr">このサイトでは自己紹介や活動，</span><span class="wbr">各種リンクを紹介しています．</span>
      </p>
      <a class="hero__start" href="#game"><span class="hero__cursor">▶</span> PRESS START</a>
      <p class="title-screen__hint">クリック または Enter キー</p>
    </section>

    <div class="game" id="game">
      <section class="section">
        <h2>コマンド</h2>
        <div class="command">
          <nav class="command__menu pixel-window" aria-label="コマンド">
            <ul class="command__list">
              {commands.map((command, i) => (
                <li>
                  <a
                    class="command__item"
                    href={command.route}
                    data-message={command.message}
                    data-preview={command.preview}
                    aria-describedby={`command-desc-${i}`}
                  >
                    {command.label}
                  </a>
                  <p id={`command-desc-${i}`} hidden>{command.message}</p>
                </li>
              ))}
              <li data-secret hidden>
                <button
                  type="button"
                  class="command__item"
                  data-score="0"
                  data-message={secretCommand.message}
                  data-call-message={secretCommand.callMessage}
                  data-leave-message={secretCommand.leaveMessage}
                >
                  {secretCommand.label}
                </button>
              </li>
            </ul>
            <p class="command__tap-hint">もういちど タップで けってい</p>
          </nav>
          <div class="command__message pixel-window">
            <p class="command__text">tomocakezombie は なにを する？</p>
            <ul class="command__preview" data-preview="projects" hidden>
              {featuredProjects.map((project) => (
                <li>
                  <a class="command-preview" href={`${pages.projects.route}${project.slug}/`}>
                    {project.videoFile && (
                      <span class="command-preview__media">
                        <video
                          src={`/assets/video/${project.videoFile}`}
                          autoplay
                          muted
                          loop
                          playsinline
                          preload="metadata"
                          aria-label={`${project.title} のデモ動画`}
                        />
                      </span>
                    )}
                    <span class="command-preview__title">{project.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <section class="section">
        <h2>ステータス</h2>
        <div class="status pixel-window">
          <div class="status__head">
            <div class="status__portrait">
              <img src={img('about/profile.png')} alt="" width="96" height="96" />
            </div>
            <div class="status__summary">
              <p class="status__name">{args.siteName}</p>
              <p class="status__job">{job}</p>
              <p class="status__level"><span class="status__level-label">LV</span> {level}</p>
            </div>
          </div>
          <dl class="status__params">
            {status.map((item) => (
              <div>
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))}
          </dl>
          {github && (
            <>
              <h3>GitHub</h3>
              <dl class="status__github">
                <div class="status__exp">
                  <dt>コントリビューション<span class="status__github-note">（かこ 1ねん）</span></dt>
                  <dd>{github.total}</dd>
                </div>
                {github.gauges.map((gauge) => (
                  <div class="status__gauge-row">
                    <dt>{gauge.label}</dt>
                    <dd>
                      <span class="status__gauge" aria-hidden="true">
                        <span class="status__gauge-fill" style={`width: ${Math.min(100, (gauge.now / gauge.max) * 100)}%`}></span>
                      </span>
                      <span class="status__gauge-text">
                        {gauge.now} / {gauge.max}{gauge.maxLabel && <span class="status__github-note">（{gauge.maxLabel}）</span>}
                      </span>
                    </dd>
                  </div>
                ))}
              </dl>
              {grassDays.length > 0 && (
                <div class="status__grass" role="img" aria-label={`かこ 1ねんの コントリビューション ${github.total} けん`}>
                  <div class="status__grass-grid">
                    {Array.from({ length: grassOffset }, () => <span class="status__grass-day is-blank" aria-hidden="true"></span>)}
                    {grassDays.map((day) => (
                      <span class={`status__grass-day is-level-${day.level}`} title={`${day.date}: ${day.count}`} aria-hidden="true"></span>
                    ))}
                  </div>
                </div>
              )}
              <p class="status__github-date">{fetchedDate} じてん</p>
            </>
          )}
          <h3>しょうごう</h3>
          <ul class="status__titles">
            {titles.map((item) => (
              <li class="status__title">
                <span class="status__value">{item.value}</span>
                <span class="status__name">{item.name}</span>
                <span class="status__year">{item.year}</span>
              </li>
            ))}
          </ul>
          <p class="status__more"><a href={pages.achievements.route}>じっせきを すべて みる</a></p>
        </div>
      </section>
    </div>

    <section class="section contact">
      <h2>連絡先</h2>
      <div class="pixel-window">
        <dl class="contact-list">
          {contacts.map((c) => (
            <div>
              <dt>{c.label}</dt>
              <dd>
                <a href={c.href} target={c.external ? '_blank' : undefined} rel={c.external ? 'noopener noreferrer' : undefined}>
                  {c.text}
                </a>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  </div>

  <script>
    const score = (window as any).siteScore;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ------------------------------------------------------------------
    // 背景を流れる雲・ハムスター
    // ------------------------------------------------------------------
    const container = document.getElementById('hamsterContainer')!;

    // 流す画像の一覧。種類を増やすときは public/assets/img/ に画像を置いてここに追加する
    // weight が大きいほど出やすい。tilt が true のものは傾けて表示する
    const sprites = [
      { src: '/assets/img/cloud-normal.png', weight: 10, tilt: false },
      { src: '/assets/img/hamster.png', weight: 1, tilt: true },
      { src: '/assets/img/cloud.png', weight: 1, tilt: true },
      { src: '/assets/img/coffee.png', weight: 1, tilt: true },
    ];
    const hamsterSprite = sprites[1];

    const pickSprite = () => {
      const total = sprites.reduce((sum, s) => sum + s.weight, 0);
      let r = Math.random() * total;
      for (const s of sprites) {
        r -= s.weight;
        if (r < 0) return s;
      }
      return sprites[sprites.length - 1];
    };

    // duration を省略すると 40-70 秒でゆっくり横断する
    const createHamster = (maxDelay: number, sprite = pickSprite(), duration = 40 + Math.random() * 30) => {
      const size = 120 + Math.random() * 60; // 120-180px
      const rotate = sprite.tilt ? -30 + Math.random() * 60 : 0; // 傾ける場合は -30〜30度
      const delay = Math.random() * maxDelay;

      const hamster = document.createElement('div');
      hamster.className = 'hamster';
      hamster.style.backgroundImage = `url('${sprite.src}')`;
      hamster.style.setProperty('--rotate', `${rotate}deg`);
      hamster.style.setProperty('--size', `${size}px`);
      hamster.style.setProperty('--start-y', `${10 + Math.random() * 75}%`);
      hamster.style.setProperty('--duration', `${duration}s`);
      hamster.style.setProperty('--delay', `${delay}s`);
      hamster.style.setProperty('--opacity', String(0.6 + Math.random() * 0.4));
      container.appendChild(hamster);

      hamster.addEventListener('animationend', () => hamster.remove());
      return hamster;
    };

    for (let i = 0; i < 3; i++) createHamster(20);
    setInterval(() => createHamster(0), 15000);

    // かくしコマンド・うらわざで呼ぶハムスターの大群
    // 全員が画面の外へ出たら、ほかのコマンドを選んでいない限り「さっていった」と表示する
    let rushCount = 0;
    const summonHamsters = () => {
      for (let i = 0; i < 12; i++) {
        rushCount += 1;
        createHamster(4, hamsterSprite, 8 + Math.random() * 6).addEventListener('animationend', () => {
          rushCount -= 1;
          if (rushCount === 0 && (!selected || selected === secretButton)) typeMessage(secretButton.dataset.leaveMessage ?? '');
        });
      }
    };
    document.addEventListener('konami', summonHamsters);

    // ------------------------------------------------------------------
    // 歩く棒人間（クリックすると加点）
    // ------------------------------------------------------------------
    const walker = document.querySelector<HTMLButtonElement>('.walker')!;
    const walkerImg = walker.querySelector('img')!;
    const copyright = document.querySelector<HTMLElement>('.copyright')!;
    const FEET_RATIO = 0.87; // 画像内で足先が来る高さの割合（viewBox 200 中の約 174）
    const GROUND_OFFSET = -18; // 地面の微調整（px）。正の値で下に、負の値で上に動く

    const WALKER_SIZE = 120; // CSS の width と同じ値（非表示中は offsetHeight が取れないため固定値を使う）
    const WALKER_POINTS = 300; // つかまえたときの加点

    const placeWalker = () => {
      const top = copyright.getBoundingClientRect().top - WALKER_SIZE * FEET_RATIO + GROUND_OFFSET;
      walker.style.top = `${top}px`;
    };

    const WALKER_CHANCE = 0.6; // 判定ごとの出現確率
    const WALKER_INTERVAL = 10000; // 判定の間隔（ms）
    let walking = false;
    let caught = false;

    const startWalker = () => {
      walking = true;
      caught = false;
      placeWalker();
      walker.hidden = false;
      walker.classList.remove('is-walking', 'is-caught');
      void walker.offsetWidth;
      walker.classList.add('is-walking');
    };

    walker.addEventListener('click', () => {
      if (caught) return;
      caught = true;
      walker.classList.add('is-caught');
      score?.add(WALKER_POINTS);
      score?.unlock('walker');
    });

    walkerImg.addEventListener('load', placeWalker);
    walker.addEventListener('animationend', (event) => {
      // 中の画像のジャンプ演出の終わりは無視する
      if (event.target !== walker) return;
      walker.classList.remove('is-walking');
      walker.hidden = true;
      walking = false;
    });
    window.addEventListener('scroll', placeWalker, { passive: true });
    window.addEventListener('resize', placeWalker);
    placeWalker();

    setInterval(() => {
      if (!walking && Math.random() < WALKER_CHANCE) startWalker();
    }, WALKER_INTERVAL);

    // ------------------------------------------------------------------
    // コマンドメニュー
    // ------------------------------------------------------------------
    const menu = document.querySelector<HTMLElement>('.command__list')!;
    const messageText = document.querySelector<HTMLElement>('.command__text')!;
    const previews = document.querySelectorAll<HTMLElement>('[data-preview]:not(.command__item)');
    const secret = menu.querySelector<HTMLElement>('[data-secret]')!;
    const secretButton = secret.querySelector('button')!;
    const TYPE_INTERVAL = 40; // 1 文字あたりの表示間隔（ms）

    const commandItems = () => [...menu.querySelectorAll<HTMLElement>('.command__item')].filter((item) => !item.closest('[hidden]'));

    let typingTimer = 0;
    const typeMessage = (text: string) => {
      clearInterval(typingTimer);
      messageText.classList.remove('is-done');
      if (reduceMotion) {
        messageText.textContent = text;
        messageText.classList.add('is-done');
        return;
      }
      const chars = Array.from(text);
      let count = 0;
      messageText.textContent = '';
      typingTimer = window.setInterval(() => {
        count += 1;
        messageText.textContent = chars.slice(0, count).join('');
        if (count >= chars.length) {
          clearInterval(typingTimer);
          messageText.classList.add('is-done');
        }
      }, TYPE_INTERVAL);
    };

    let selected: HTMLElement | null = null;
    const select = (item: HTMLElement | null | undefined) => {
      if (!item || item === selected) return;
      selected?.classList.remove('is-selected');
      selected = item;
      item.classList.add('is-selected');
      typeMessage(item.dataset.message ?? '');
      previews.forEach((preview) => {
        preview.hidden = preview.dataset.preview !== item.dataset.preview;
      });
    };

    const itemFrom = (target: EventTarget | null) => (target instanceof Element ? target.closest<HTMLElement>('.command__item') : null);
    menu.addEventListener('focusin', (event) => select(itemFrom(event.target)));
    menu.addEventListener('mouseover', (event) => select(itemFrom(event.target)));

    // タッチ操作（スマホ）では、1 回目のタップで選択して説明を出し、同じ場所をもう 1 回タップするとコマンドを実行する
    // タップすると mouseover / focus で先に選択されてしまうため、指が触れた瞬間（pointerdown）に「もう選択済みだったか」を覚えておく
    // マウス・キーボード（Enter）は pointerdown が touch / pen にならないので、これまでどおり 1 回で実行する
    let tappedItem: HTMLElement | null = null;
    let tappedWasSelected = false;
    menu.addEventListener(
      'pointerdown',
      (event) => {
        tappedItem = event.pointerType === 'mouse' ? null : itemFrom(event.target);
        tappedWasSelected = tappedItem !== null && tappedItem === selected;
      },
      true,
    );
    // かくしコマンド（ボタン）の click より先に判定するため、キャプチャ段階で受ける
    menu.addEventListener(
      'click',
      (event) => {
        const item = itemFrom(event.target);
        const wasSelected = tappedWasSelected;
        const tapped = tappedItem;
        tappedItem = null;
        if (!item || item !== tapped || wasSelected) return;
        // 選ぶだけのタップなので、遷移・かくしコマンドの実行・スコアの加点はしない
        event.preventDefault();
        event.stopPropagation();
        select(item);
      },
      true,
    );

    // ↑↓ でコマンドを移動する（端まで行くと反対側に戻る）
    menu.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
      event.preventDefault();
      const items = commandItems();
      const current = items.indexOf(document.activeElement as HTMLElement);
      const step = event.key === 'ArrowDown' ? 1 : -1;
      items[(current + step + items.length) % items.length]?.focus();
    });

    // かくしコマンドは、スコア 1000 か うらわざ で出てくる
    const revealSecret = () => {
      if (score?.isUnlocked('score1000') || score?.isUnlocked('konami')) secret.hidden = false;
    };
    revealSecret();
    document.addEventListener('unlock', revealSecret);
    // タップではフォーカスが移らないブラウザもあるので、押したときにも選択とメッセージを出し直す
    secretButton.addEventListener('click', () => {
      select(secretButton);
      typeMessage(secretButton.dataset.callMessage ?? '');
      summonHamsters();
    });

    // ------------------------------------------------------------------
    // タイトル画面（PRESS START でゲーム画面へ）
    // ------------------------------------------------------------------
    const title = document.getElementById('title')!;
    const game = document.getElementById('game')!;
    const startLink = title.querySelector<HTMLAnchorElement>('.hero__start')!;
    const START_DELAY = 600; // 点滅させてから移動するまで（ms）
    let starting = false;

    // タッチ操作（スマホ）の PRESS START は、「自己紹介」を 1 回タップしたときと同じく「選択するだけ」にする
    // focus() まで呼ぶと、選択中の枠（.is-selected）にフォーカス枠が重なって二重に見える
    let startByTouch = false;
    startLink.addEventListener('pointerdown', (event) => {
      startByTouch = event.pointerType !== 'mouse';
    });

    const pressStart = (byTouch = false) => {
      if (starting) return;
      starting = true;
      startLink.classList.add('is-starting');
      score?.unlock('start');
      setTimeout(
        () => {
          starting = false;
          startLink.classList.remove('is-starting');
          game.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth' });
          const first = commandItems()[0];
          if (!byTouch) first?.focus({ preventScroll: true });
          select(first);
        },
        reduceMotion ? 0 : START_DELAY,
      );
    };

    startLink.addEventListener('click', (event) => {
      event.preventDefault();
      const byTouch = startByTouch;
      startByTouch = false;
      pressStart(byTouch);
    });

    // どこにもフォーカスがなく、タイトル画面が見えているときは Enter でも始められる
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' || document.activeElement !== document.body) return;
      if (title.getBoundingClientRect().bottom < window.innerHeight / 2) return;
      pressStart();
    });
  </script>

  <style is:global>
    .hamster-container {
      position: fixed;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
      z-index: -1;
    }

    .hamster {
      position: absolute;
      top: var(--start-y);
      left: 100%;
      width: var(--size);
      height: var(--size);
      background: center / contain no-repeat;
      image-rendering: pixelated;
      opacity: var(--opacity);
      animation: hamster-float var(--duration) linear var(--delay) both;
    }

    .walker {
      position: fixed;
      left: 0;
      top: 0;
      width: 120px;
      padding: 0;
      border: 0;
      background: none;
      cursor: pointer;
      z-index: 1;
    }

    .walker img {
      display: block;
      width: 100%;
      height: auto;
      filter: brightness(0) invert(1);
    }

    .walker.is-walking {
      animation: walker-move 40s linear both;
    }

    .walker.is-caught {
      cursor: default;
    }

    .walker.is-caught img {
      animation: walker-hop 0.4s steps(4) 2;
      filter: brightness(0) invert(1) drop-shadow(0 0 6px #ffd84a);
    }

    @keyframes walker-move {
      from {
        transform: translateX(-120px);
      }
      to {
        transform: translateX(100vw);
      }
    }

    @keyframes walker-hop {
      50% {
        transform: translateY(-24px);
      }
    }

    @keyframes hamster-float {
      0% {
        transform: translate(0, 0) rotate(var(--rotate));
      }
      50% {
        transform: translate(calc(-50vw - 50%), -20px) rotate(var(--rotate));
      }
      100% {
        transform: translate(calc(-100vw - 100%), 0) rotate(var(--rotate));
      }
    }
  </style>
</Layout>
