---
import { app, args, pages, assets, img } from '/src/config/view';
import { Layout } from '/src/layouts';
app.init(Astro);
app.setPageConfig();
---

<Layout>
  <div class="content-main">
    <section class="hero">
      <p class="hero__sub">PORTFOLIO</p>
      <h2 class="hero__title">{args.siteName}</h2>
      <p class="hero__text">
        <span class="wbr">山梨大学 工学部</span> <span class="wbr">コンピュータ理工学科の学生です．</span><br />
        <span class="wbr">自己紹介や活動，</span><span class="wbr">各種リンクをまとめています．</span>
      </p>
      <p class="hero__start"><span class="hero__cursor">▶</span> PRESS START</p>
    </section>

    <section class="section">
      <h2>メニュー</h2>
      <ul class="menu-list">
        <li>
          <a class="menu-card" href={pages.about.route}>
            <span class="menu-card__title">自己紹介</span>
            <span class="menu-card__text">プロフィール・所属・活動について</span>
          </a>
        </li>
        <li>
          <a class="menu-card" href={pages.links.route}>
            <span class="menu-card__title">外部リンク</span>
            <span class="menu-card__text">GitHub や学内サイトへのリンク集</span>
          </a>
        </li>
        <li>
          <div class="menu-card is-disabled">
            <span class="menu-card__title">作品</span>
            <span class="menu-card__text">じゅんびちゅう…</span>
          </div>
        </li>
        <li>
          <a class="menu-card" href={pages.achievements.route}>
            <span class="menu-card__title">実績</span>
            <span class="menu-card__text">資格・サークル経歴・CTF 実績</span>
          </a>
        </li>
        <li>
          <a class="menu-card" href={pages.blog.route}>
            <span class="menu-card__title">ブログ</span>
            <span class="menu-card__text">技術メモ・活動記録（じゅんびちゅう…）</span>
          </a>
        </li>
      </ul>
    </section>
  </div>
</Layout>
