---
import { app, args, pages, assets, img } from '@/config/view.mjs';
import { Layout } from '@/layouts';
app.init(Astro);
app.setPageConfig();

const contacts = [
  { label: 'メール', text: 't23cs014@yamanashi.ac.jp', href: 'mailto:t23cs014@yamanashi.ac.jp', external: false },
  { label: 'GitHub', text: 'tomocakezombie', href: 'https://github.com/tomocakezombie', external: true },
  { label: 'X', text: '@kan1175423', href: 'https://x.com/kan1175423', external: true },
];
---

<Layout>
  <div class="hamster-container" id="hamsterContainer"></div>
  <img class="walker" src="/assets/img/walking-stickman.svg" alt="" aria-hidden="true" hidden />
  <div class="content-main">
    <section class="hero">
      <p class="hero__sub">PORTFOLIO</p>
      <h2 class="hero__title">{args.siteName}</h2>
      <p class="hero__text">
        <span class="wbr">山梨大学 工学部</span> <span class="wbr">コンピュータ理工学科の学生です．</span><br />
        <span class="wbr">サイバーセキュリティと計算機の保守運用をメインに活動しています．</span><br />
        <span class="wbr">このサイトでは自己紹介や活動，</span><span class="wbr">各種リンクを紹介しています．</span>
      </p>
      <p class="hero__start"><span class="hero__cursor">▶</span> PRESS START</p>
    </section>

    <section class="section">
      <h2>メニュー</h2>
      <ul class="menu-list">
        <li>
          <a class="menu-card" href={pages.about.route}>
            <span class="menu-card__title">自己紹介</span>
            <span class="menu-card__text">プロフィール・所属・活動について</span>
          </a>
        </li>
        <li>
          <a class="menu-card" href={pages.links.route}>
            <span class="menu-card__title">外部リンク</span>
            <span class="menu-card__text">GitHub や学内サイトへのリンク集</span>
          </a>
        </li>
        <li>
          <a class="menu-card" href={pages.projects.route}>
            <span class="menu-card__title">作品</span>
            <span class="menu-card__text">作成したアプリ・GitHub プロジェクト</span>
          </a>
        </li>
        <li>
          <a class="menu-card" href={pages.achievements.route}>
            <span class="menu-card__title">実績</span>
            <span class="menu-card__text">資格・サークル経歴・CTF 実績</span>
          </a>
        </li>
        <li>
          <a class="menu-card" href={pages.blog.route}>
            <span class="menu-card__title">ブログ</span>
            <span class="menu-card__text">技術メモ・活動記録（じゅんびちゅう…）</span>
          </a>
        </li>
        <li>
          <a class="menu-card" href={pages.settings.route}>
            <span class="menu-card__title">設定</span>
            <span class="menu-card__text">サイトの設定</span>
            <span class="menu-card__text">フォントの切り替えができます</span>
          </a>
        </li>
      </ul>
    </section>

    <section class="section contact">
      <h2>連絡先</h2>
      <div class="pixel-window">
        <dl class="contact-list">
          {contacts.map((c) => (
            <div>
              <dt>{c.label}</dt>
              <dd>
                <a href={c.href} target={c.external ? '_blank' : undefined} rel={c.external ? 'noopener noreferrer' : undefined}>
                  {c.text}
                </a>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  </div>

  <script>
    const container = document.getElementById('hamsterContainer')!;

    // 流す画像の一覧。種類を増やすときは public/assets/img/ に画像を置いてここに追加する
    // weight が大きいほど出やすい。tilt が true のものは傾けて表示する
    const sprites = [
      { src: '/assets/img/cloud-normal.png', weight: 10, tilt: false },
      { src: '/assets/img/hamster.png', weight: 1, tilt: true },
      { src: '/assets/img/cloud.png', weight: 1, tilt: true },
      { src: '/assets/img/coffee.png', weight: 1, tilt: true },
    ];

    const pickSprite = () => {
      const total = sprites.reduce((sum, s) => sum + s.weight, 0);
      let r = Math.random() * total;
      for (const s of sprites) {
        r -= s.weight;
        if (r < 0) return s;
      }
      return sprites[sprites.length - 1];
    };

    const createHamster = (maxDelay: number) => {
      const size = 120 + Math.random() * 60; // 120-180px
      const sprite = pickSprite();
      const rotate = sprite.tilt ? -30 + Math.random() * 60 : 0; // 傾ける場合は -30〜30度
      const duration = 40 + Math.random() * 30; // 40-70秒でゆっくり横断
      const delay = Math.random() * maxDelay;

      const hamster = document.createElement('div');
      hamster.className = 'hamster';
      hamster.style.backgroundImage = `url('${sprite.src}')`;
      hamster.style.setProperty('--rotate', `${rotate}deg`);
      hamster.style.setProperty('--size', `${size}px`);
      hamster.style.setProperty('--start-y', `${10 + Math.random() * 75}%`);
      hamster.style.setProperty('--duration', `${duration}s`);
      hamster.style.setProperty('--delay', `${delay}s`);
      hamster.style.setProperty('--opacity', String(0.6 + Math.random() * 0.4));
      container.appendChild(hamster);

      hamster.addEventListener('animationend', () => hamster.remove());
    };

    for (let i = 0; i < 3; i++) createHamster(20);
    setInterval(() => createHamster(0), 15000);

    const walker = document.querySelector<HTMLImageElement>('.walker')!;
    const copyright = document.querySelector<HTMLElement>('.copyright')!;
    const FEET_RATIO = 0.87; // 画像内で足先が来る高さの割合（viewBox 200 中の約 174）
    const GROUND_OFFSET = -18; // 地面の微調整（px）。正の値で下に、負の値で上に動く

    const WALKER_SIZE = 120; // CSS の width と同じ値（非表示中は offsetHeight が取れないため固定値を使う）

    const placeWalker = () => {
      const top = copyright.getBoundingClientRect().top - WALKER_SIZE * FEET_RATIO + GROUND_OFFSET;
      walker.style.top = `${top}px`;
    };

    const WALKER_CHANCE = 0.6; // 判定ごとの出現確率
    const WALKER_INTERVAL = 10000; // 判定の間隔（ms）
    let walking = false;

    const startWalker = () => {
      walking = true;
      placeWalker();
      walker.hidden = false;
      walker.classList.remove('is-walking');
      void walker.offsetWidth;
      walker.classList.add('is-walking');
    };

    walker.addEventListener('load', placeWalker);
    walker.addEventListener('animationend', () => {
      walker.classList.remove('is-walking');
      walker.hidden = true;
      walking = false;
    });
    window.addEventListener('scroll', placeWalker, { passive: true });
    window.addEventListener('resize', placeWalker);
    placeWalker();

    setInterval(() => {
      if (!walking && Math.random() < WALKER_CHANCE) startWalker();
    }, WALKER_INTERVAL);
  </script>

  <style is:global>
    .hamster-container {
      position: fixed;
      inset: 0;
      overflow: hidden;
      pointer-events: none;
      z-index: -1;
    }

    .hamster {
      position: absolute;
      top: var(--start-y);
      left: 100%;
      width: var(--size);
      height: var(--size);
      background: center / contain no-repeat;
      image-rendering: pixelated;
      opacity: var(--opacity);
      animation: hamster-float var(--duration) linear var(--delay) both;
    }

    .walker {
      position: fixed;
      left: 0;
      top: 0;
      width: 120px;
      height: auto;
      z-index: 1;
      pointer-events: none;
      filter: brightness(0) invert(1);
    }

    .walker.is-walking {
      animation: walker-move 40s linear both;
    }

    @keyframes walker-move {
      from {
        transform: translateX(-120px);
      }
      to {
        transform: translateX(100vw);
      }
    }

    @keyframes hamster-float {
      0% {
        transform: translate(0, 0) rotate(var(--rotate));
      }
      50% {
        transform: translate(calc(-50vw - 50%), -20px) rotate(var(--rotate));
      }
      100% {
        transform: translate(calc(-100vw - 100%), 0) rotate(var(--rotate));
      }
    }
  </style>
</Layout>
